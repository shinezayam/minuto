# .env.example -> .env болгож хуулаад бөглөнө. .env-ийг хэзээ ч git-д оруулахгүй.

# --- ASR (ярианаас текст) ---
# scribe = ElevenLabs Scribe (бүтэн файл, хурлын хэмжээний яригч), omni = Qwen-Omni API,
# whisper = локал Whisper (2GB+ RAM), demo = [ДЕМО] шошготой бичвэр
ASR_PROVIDER=omni
# ASR_PROVIDER=scribe үед: elevenlabs.io → Developers → API Keys (Speech to Text эрхтэй)
ELEVENLABS_API_KEY=
SCRIBE_MODEL=scribe_v3
WHISPER_MODEL=medium
OMNI_MODEL=qwen3.8-omni-flash
# Omni руу нэг удаа илгээх аудионы урт (сек), зэрэг илгээх хүсэлтийн тоо
OMNI_CHUNK_SEC=30
ASR_CONCURRENCY=4

# --- LLM (хурлын тэмдэглэл, шийдвэр, даалгавар) ---
# qwen | demo
LLM_PROVIDER=qwen
QWEN_API_KEY=
# Гэрэгэ Token Hub (OpenAI-compatible): https://tokenhub.mn/v1
# Alibaba шууд:  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://tokenhub.mn/v1
QWEN_MODEL=qwen3.8-max
QWEN_TIMEOUT_SEC=180
# true болговол хариу ~10-20 дахин удааширна
QWEN_ENABLE_THINKING=false

# --- Бусад ---
# Хоосон бол PATH-аас хайна
FFMPEG_PATH=
CORS_ORIGINS=http://localhost:3000
MAX_AUDIO_CHUNK_BYTES=5000000
AUDIO_STORAGE_PATH=./audio_storage

# --- Мэдээллийн сан, нэвтрэлт ---
# Хоосон бол локал SQLite (./minuto.db). Postgres: postgresql://user:pass@host:5432/db
DATABASE_URL=
# Токены нууц (32+ тэмдэгт). Хоосон бол сервер эхлэх бүрт шинээр үүсч бүгд дахин нэвтэрнэ.
JWT_SECRET=
JWT_TTL_DAYS=30
ALLOW_REGISTRATION=true

# Хурлын үеэр бичвэрийг шууд харуулах (ASR-ийг ~2 дахин их хэрэглэнэ). Унтраах бол false.
LIVE_TRANSCRIPTION=true
# LIVE_MIN_SEC=8
# LIVE_WINDOW_SEC=15
# LIVE_MAX_SEC=25

# --- Billing (docs/BILLING.md). Default-оор бүгд унтраалттай ---
# off = юу ч тоолохгүй | shadow = минутыг бүртгэнэ, юуг ч хаахгүй | enforce = минут дууссан бол шинэ боловсруулалт хаана
BILLING_METERING=off
# Төлбөрийн товчийг нээх (WIRE_API_KEY тохируулсны дараа)
BILLING_CHECKOUT_ENABLED=false
# Wire (wire.mn) dashboard-аас: sk_... түлхүүр, webhook endpoint-ийн whsec_... secret. Render env-д л оруулна.
WIRE_API_KEY=
WIRE_WEBHOOK_SECRET=
# WIRE_BASE_URL=https://api.wire.mn
# Төлсний дараа буцах frontend (хоосон бол CORS_ORIGINS-ийн эхнийх)
FRONTEND_URL=

# --- Google-ээр нэвтрэх (Google Cloud → APIs & Services → Credentials → OAuth client ID, type: Web) ---
# Нууц биш (frontend ч харна). Хоосон бол "Google-ээр нэвтрэх" товч харагдахгүй.
GOOGLE_CLIENT_ID=

# --- Админ ---
# Enterprise хүсэлт зэрэг дотоод хуудсыг харах хэрэглэгчдийн и-мэйл (таслалаар)
ADMIN_EMAILS=

# Аудио Supabase-д (AUDIO_STORAGE_BACKEND=supabase): Supabase Free дээр нэг файл 50MB хүртэл (~60 мин webm).
# Урт бичлэг хадгалах бол Supabase Pro эсвэл bucket-ийн "file size limit"-ийг нэмэгдүүлнэ. Хуулсны дараа хэмжээг шалгана.
