# .env.example -> .env болгож хуулаад бөглөнө. .env-ийг хэзээ ч git-д оруулахгүй.

# --- ASR (ярианаас текст) ---
# omni = Qwen-Omni API, whisper = локал Whisper (2GB+ RAM), demo = [ДЕМО] шошготой бичвэр
ASR_PROVIDER=omni
WHISPER_MODEL=medium
OMNI_MODEL=qwen3.8-omni-flash
# Omni руу нэг удаа илгээх аудионы урт (сек), зэрэг илгээх хүсэлтийн тоо
OMNI_CHUNK_SEC=30
ASR_CONCURRENCY=4

# --- LLM (хурлын тэмдэглэл, шийдвэр, даалгавар) ---
# qwen | demo
LLM_PROVIDER=qwen
QWEN_API_KEY=
# Гэрэгэ Token Hub (OpenAI-compatible): https://ali.gerege.mn/v1
# Alibaba шууд:  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://ali.gerege.mn/v1
QWEN_MODEL=qwen3.7-plus
QWEN_TIMEOUT_SEC=180
# true болговол хариу ~10-20 дахин удааширна
QWEN_ENABLE_THINKING=false

# --- Бусад ---
# Хоосон бол PATH-аас хайна
FFMPEG_PATH=
CORS_ORIGINS=http://localhost:3000
MAX_AUDIO_CHUNK_BYTES=5000000
AUDIO_STORAGE_PATH=./audio_storage

# --- Одоогоор ашиглагдаагүй (Supabase/Postgres дараагийн шатанд) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=meeting-audio-private
